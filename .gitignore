
# Wrangler local cache/state (contains account id, not for the repo)
workers/.wrangler/
.wrangler/

# The deployed Worker source. wrangler.toml points main at it so `wrangler deploy`
# has something to upload, but it NEVER enters this repo: it carries WW_KEY,
# NS_CLIENT_SECRET and NS_TOKEN_DEFAULT in plain text and this repo is public.
# Keep the working copy at "Manly swim/worker-NEW.js" in Drive and copy it in.
worker.js

# Bake caches for the species dataset: API results and 11MB of FishBase TSVs.
# Regenerable, and re-running is free because everything keys on taxon id.
.bake-cache/
